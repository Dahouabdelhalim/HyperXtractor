    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Environment</IRI>
        <Literal>Execution environment in which the experiment runs (hardware + software).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Experiment</IRI>
        <Literal>A concrete execution of an ML process (training, testing, or evaluation) under specified conditions.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Person</IRI>
        <Literal>Represents a researcher, author, or contributor of a study.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Prompt</IRI>
        <Literal>Natural-language or structured instruction used in prompt-based or generative ML experiments.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Study</IRI>
        <Literal>Represents a scientific investigation or publication that contains one or more experiments. It is the top-level entity describing ML research.</Literal>
    </AnnotationAssertion>
