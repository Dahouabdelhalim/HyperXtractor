          ],
          "mls:model": {"@id": "model:cnn"},
          "mls:result": {
            "value": "CNN-based classifier shows overall superiority in performance (sample-complexity) compared to state-of-the-art estimators",
            "start_char_doc": null,
            "end_char_doc": null,
            "prefix": null,
            "suffix": null,
            "valueSource": "inferred"
          },
          "start_char_doc": 27839,
          "end_char_doc": 28700,
          "prefix": "across all plots. Fig. 3",
          "suffix": "Fig. 4a illustrates the robustness"
        },
        {
          "@id": "exp:noise_robustness",
          "@type": "mls:Experiment",
          "schema:description": {
