        {"@id": "hp:spectral_radius_constraint"}
      ],
      "mls:hasSubExperiment": [
        {
          "@id": "exp:cnn_sample_complexity",
          "@type": "mls:Experiment",
          "schema:description": {
            "value": "Sample-complexity performance comparison of CNN-based classifier against Granger, one-lag, R1-R3 estimators, and linear SVM across structurally distinct networks (dense and sparse, directed and undirected)",
            "start_char_doc": null,
            "end_char_doc": null,
            "prefix": null,
            "suffix": null,
            "valueSource": "inferred"
          },
          "mls:dataset": [
            {"@id": "dataset:erdos_renyi_random_graph"},
