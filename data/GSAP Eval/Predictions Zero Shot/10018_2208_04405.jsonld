    {
      "@id": "exp:group_graph_structure_identification_2022",
      "@type": "mls:ExperimentGroup",
      "mention": {
        "start_char_doc": 27594,
        "end_char_doc": 27612,
        "prefix": "S = {1, 2, . . . , 20}.",
