      "occurrences": [
        [27594, 27612, "experiments"]
      ],
      "mls:hypothesis": {
        "value": "CNNs trained with covariance-based feature vectors outperform state-of-the-art methods (Granger, one-lag, R1-R3 estimators, linear SVM) in terms of accuracy and sample complexity for graph structure identification under partial observability",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "mls:methodology": {
        "value": "Train classifiers (CNN, linear SVM) over covariance-based feature vectors from one realization of Erdős-Rényi random graph (p=0.5, N=100, |S|=20 observed nodes), then evaluate on structurally distinct networks including real-world ones using 1000 Monte Carlo runs",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "mls:evaluationMeasure": {"@id": "eval:accuracy"},
      "mls:task": {"@id": "task:graph_structure_identification"},
