        {"@id": "task:graph_structure_identification"},
        {"@id": "task:causal_inference"}
      ],
      "usesData": [
        {"@id": "dataset:erdos_renyi_random_graph"},
        {"@id": "dataset:binomial_random_graph"},
        {"@id": "dataset:real_world_networks"}
      ],
      "produces": [
        {"@id": "model:cnn"},
        {"@id": "model:linear_svm"},
        {"@id": "method:covariance_based_feature_vectors"}
      ],
      "usesParameters": [
        {"@id": "hp:num_nodes_n"},
        {"@id": "hp:edge_probability_p"},
        {"@id": "hp:observed_nodes_s"},
        {"@id": "hp:noise_variance_sigma"},
