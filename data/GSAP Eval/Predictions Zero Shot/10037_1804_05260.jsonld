      "schema:title": {
        "value": "ClassiNet - Predicting Missing Features for Short-Text Classification",
        "start_char_doc": 0,
        "end_char_doc": 68,
        "prefix": "",
        "suffix": "Abstract: Short and sparse texts",
        "valueSource": "extracted"
      },
      "schema:abstract": {
        "value": "Short and sparse texts such as tweets, search engine snippets, product reviews, chat messages are abundant on the Web. Classifying such shorttexts into a pre-defined set of categories is a common problem that arises in various contexts, such as sentiment classification, spam detection, and information recommendation. The fundamental problem in short-text classification is feature sparseness -the lack of feature overlap between a trained model and a test instance to be classified. We propose ClassiNet -a network of classifiers trained for predicting missing features in a given instance, to overcome the feature sparseness problem.",
        "start_char_doc": 80,
        "end_char_doc": 710,
        "prefix": "Abstract:",
        "suffix": "Using a set of unlabeled",
        "valueSource": "extracted"
      },
