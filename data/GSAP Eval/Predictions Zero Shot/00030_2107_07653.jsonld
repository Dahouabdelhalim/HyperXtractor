      "schema:identifier": {
        "value": "TAPEX Experiments",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "schema:description": {
        "value": "Comprehensive evaluation of TAPEX on four benchmark datasets: WikiSQL, WikiTableQuestions, SQA, and TabFact.",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "schema:objective": {
        "value": "Demonstrate that table pre-training via learning a neural SQL executor achieves state-of-the-art results on table understanding tasks.",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "schema:hypothesis": {
        "value": "If a language model can be pre-trained to faithfully execute SQL queries and produce correct results, it should have a deep understanding of tables, and the execution pre-training task could be more efficient in understanding tables and reasoning over tables.",
        "start_char_doc": 5622,
        "end_char_doc": 5878,
        "prefix": "Our key insight is that",
        "suffix": "To our knowledge, TAPEX is",
        "valueSource": "extracted"
      },
      "schema:methodology": {
        "value": "Pre-train BART Large as a neural SQL executor on a synthetic corpus of 5 million SQL query-execution result pairs, then fine-tune on downstream table tasks using a generative sequence-to-sequence paradigm.",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "realizes": [
        {
          "@id": "task:table_question_answering"
        },
        {
          "@id": "task:table_fact_verification"
        }
      ],
