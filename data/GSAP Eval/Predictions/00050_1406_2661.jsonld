  "@graph": [
    {
      "@id": "study:generative_adversarial_nets_2014",
      "@type": "Study",
      "mention": {
        "start_char_doc": 0,
        "end_char_doc": 27,
        "prefix": "",
        "suffix": "Abstract: We propose a new",
        "section": "title",
        "valueSource": "extracted"
      },
      "occurrences": [
        [
          0,
          27,
          "title"
        ]
      ],
      "schema:title": {
        "value": "Generative Adversarial Nets",
        "start_char_doc": 0,
        "end_char_doc": 27,
        "prefix": "",
        "suffix": "Abstract: We propose a new",
        "valueSource": "extracted"
      },
      "schema:abstract": {
        "value": "We propose a new framework for estimating generative models via an adversarial process, in which we simultaneously train two models: a generative model G that captures the data distribution, and a discriminative model D that estimates the probability that a sample came from the training data rather than G. The training procedure for G is to maximize the probability of D making a mistake. This framework corresponds to a minimax two-player game. In the space of arbitrary functions G and D, a unique solution exists, with G recovering the training data distribution and D equal to 1 2 everywhere. In the case where G and D are defined by multilayer perceptrons, the entire system can be trained with backpropagation. There is no need for any Markov chains or unrolled approximate inference networks during either training or generation of samples. Experiments demonstrate the potential of the framework through qualitative and quantitative evaluation of the generated samples.",
        "start_char_doc": 39,
        "end_char_doc": 1018,
        "prefix": "Abstract:",
        "suffix": "",
        "valueSource": "extracted"
      },
      "schema:url": {
        "value": "https://arxiv.org/abs/1406.2661",
        "start_char_doc": null,
        "end_char_doc": null,
