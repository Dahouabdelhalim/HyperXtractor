        { "@id": "eval_mention_id" },
        { "@id": "eval_binary_rel" },
        { "@id": "eval_4ary_rel" }
      ],
      "context": {
        "prefix": "We develop a ",
        "suffix": " that performs document-level IE tasks jointly in an end-to-end fashion."
      }
    },
