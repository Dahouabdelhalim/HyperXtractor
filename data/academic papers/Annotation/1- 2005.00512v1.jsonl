      "mls:language": "English",
      "mls:modality": "Text",
      "mls:description": "A document level IE dataset that encompasses multiple IE tasks, including salient entity identification and document level N-ary relation identification from scientific articles.",
      "context": {
        "prefix": "In this paper, we introduce ",
        "suffix": ", a document level IE dataset"
      }
    },
    {
