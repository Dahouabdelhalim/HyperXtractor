      "mls:name": "Document-Level Information Extraction",
      "start_char_doc": 1056,
      "end_char_doc": 1093,
      "wasDerivedFrom": "paper",
      "mls:description": "Extracting information from full documents, identifying document-level relationships that go beyond sentences or even sections.",
      "context": {
        "prefix": "Creating datasets for ",
        "suffix": " is challenging because it requires domain expertise"
      }
    },
