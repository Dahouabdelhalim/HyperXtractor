      "start_char_doc": 2520,
      "end_char_doc": 2539,
      "wasDerivedFrom": "paper",
      "mls:description": "Extracting N-ary relations between entities in a scientific article (binary, 3-ary, and 4-ary relations).",
      "context": {
        "prefix": "**Relation Extraction** is the task of extracting ",
        "suffix": " between entities in a scientific article."
      }
