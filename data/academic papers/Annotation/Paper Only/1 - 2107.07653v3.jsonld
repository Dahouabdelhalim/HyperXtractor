      "schema:methodology": {
        "value": "Pre-train BART-Large as a neural SQL executor on 5 million synthetic SQL query-execution result pairs, then fine-tune on downstream tasks using a generative sequence-to-sequence paradigm. Report median performance over five random runs.",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
