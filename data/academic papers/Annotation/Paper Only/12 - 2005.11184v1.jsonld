    {
      "@id": "method:e2e_ner_from_speech",
      "@type": "Method",
      "mention": {
        "start_char_doc": 1095,
        "end_char_doc": 1107,
        "prefix": "English speech and present an",
        "suffix": ", which jointly optimizes the",
        "valueSource": "extracted"
      },
      "schema:name": {
        "value": "End-to-End NER from Speech",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "schema:description": {
        "value": "An end-to-end approach for named entity recognition from English speech that jointly optimizes the ASR and NER tagger components. It uses a modified DeepSpeech2 architecture with special symbols added to the output character set to tag named entities, trained with CTC loss and decoded with prefix beam search conditioned on a 4-gram language model.",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "schema:version": {
        "value": null,
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "trainedOn": [
        { "@id": "dataset:data2_ner_english_speech" }
      ],
      "evaluatedOn": [
