      "schema:name": {
        "value": "Prefix Beam Search Decoding",
        "start_char_doc": 12676,
        "end_char_doc": 12694,
        "prefix": "on an N-gram LM using",
        "suffix": "decoding [28] and is shown",
        "valueSource": "extracted"
      },
      "schema:description": {
        "value": "Prefix beam search decoding conditioned on an N-gram language model. The decoding formula is Q(y) = log(p(l_t/x)) + alpha * log(p_LM(y)) + beta * wc(y), where alpha=1.96 and beta=6.0 control the contribution of the LM and the word count.",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
