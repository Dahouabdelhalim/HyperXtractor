        { "@id": "eval:precision_micro_e2e_ner_with_lm" },
        { "@id": "eval:recall_micro_e2e_ner_with_lm" },
        { "@id": "eval:f1_micro_e2e_ner_without_lm" },
        { "@id": "eval:precision_micro_e2e_ner_without_lm" },
        { "@id": "eval:recall_micro_e2e_ner_without_lm" }
      ],
      "subMethod": [
        { "@id": "model:deepspeech2_modified" },
        { "@id": "algo:ctc" },
        { "@id": "algo:prefix_beam_search" }
      ]
    },
    {
      "@id": "model:deepspeech2_modified",
      "@type": ["MLS_Model", "Method"],
      "mention": {
        "start_char_doc": 10468,
        "end_char_doc": 10479,
        "prefix": "use an RNN based Baidu's",
        "suffix": "(DS2) [26] neural architecture to",
        "valueSource": "extracted"
      },
      "schema:name": {
        "value": "DeepSpeech2 (modified)",
        "start_char_doc": 10468,
        "end_char_doc": 10479,
        "prefix": "use an RNN based Baidu's",
        "suffix": "(DS2) [26] neural architecture to",
        "valueSource": "extracted"
      },
      "schema:description": {
        "value": "A modified version of Baidu's DeepSpeech2 (DS2) neural architecture. DS2 is a combination of CNN and RNN (Bi-LSTM) layers, with a fully connected followed by a softmax layer. The softmax layer is modified by increasing the shape of the fully connected layer by four to accommodate extra special symbols for NER tagging in the output layer.",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "schema:version": {
        "value": null,
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "schema:architecture": {
        "value": "CNN + Bi-LSTM + Fully Connected + Softmax",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "schema:parameters": {
        "value": null,
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
