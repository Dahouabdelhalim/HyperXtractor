    {
      "@id": "exp:xlm_r_multilingual_pretraining_and_evaluation_2020",
      "@type": "Experiment",
      "mention": {
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "identifier": {
        "value": "XLM-R multilingual pretraining and downstream evaluation",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "description": {
        "value": "We consider four evaluation benchmarks. For cross-lingual understanding, we use cross-lingual natural language inference, named entity recognition, and question answering. We use the GLUE benchmark to evaluate the English performance of XLM-R and compare it to other state-of-the-art models.",
        "start_char_doc": 11869,
        "end_char_doc": 12160,
        "prefix": "BERT model. ## 4 Evaluation",
        "suffix": "**Cross-lingual Natural Language Inference (XNLI).**",
        "valueSource": "extracted"
      },
      "objective": {
        "value": "The goal of this paper is to improve cross-lingual language understanding (XLU), by carefully studying the effects of training unsupervised cross-lingual representations at a very large scale.",
        "start_char_doc": 1549,
        "end_char_doc": 1741,
        "prefix": "publicly available.¹ ## 1 Introduction",
        "suffix": "We present XLM-R a transformer-based",
        "valueSource": "extracted"
      },
      "hypothesis": {
        "value": "This paper shows that pretraining multilingual language models at scale leads to significant performance gains for a wide range of cross-lingual transfer tasks.",
        "start_char_doc": 333,
        "end_char_doc": 493,
        "prefix": "8 Apr 2020&lt;/watermark&gt; ## Abstract",
        "suffix": "We train a Transformer-based masked",
        "valueSource": "extracted"
      },
      "methodology": {
        "value": "Based on these results, we adapt the setting of Lample and Conneau (2019) and use a large Transformer model with 24 layers and 1024 hidden states, with a 250k vocabulary. We use the multilingual MLM loss and train our XLM-R model for 1.5 Million updates on five-hundred 32GB Nvidia V100 GPUs with a batch size of 8192. We leverage the SPM-preprocessed text data from CommonCrawl in 100 languages and sample languages with $\\alpha = 0.3$.",
        "start_char_doc": 22451,
        "end_char_doc": 22888,
        "prefix": "XLM-R. **5.2 Cross-lingual Understanding Results**",
        "suffix": "In this section, we show",
        "valueSource": "extracted"
      },
      "realizes": [
        {
          "@id": "task:cross_lingual_language_understanding"
        },
        {
          "@id": "task:cross_lingual_natural_language_inference"
        },
