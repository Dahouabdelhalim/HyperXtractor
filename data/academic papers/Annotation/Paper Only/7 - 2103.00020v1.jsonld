      },
      "name": {
        "value": "Zero-Shot Transfer",
        "start_char_doc": 27103,
        "end_char_doc": 27121,
        "prefix": "## 3. Experiments ### 3.1.",
        "suffix": "#### 3.1.1. MOTIVATION In computer",
        "valueSource": "extracted"
      },
      "description": {
        "value": "CLIP is pre-trained to predict if an image and a text snippet are paired together in its dataset. To perform zero-shot classification, we reuse this capability.",
        "start_char_doc": 30431,
        "end_char_doc": 30591,
        "prefix": "USING CLIP FOR ZERO-SHOT TRANSFER",
        "suffix": "For each dataset, we use",
        "valueSource": "extracted"
      },
      "objective": {
        "value": "Learn transferable visual representations from natural language supervision and evaluate them through zero-shot transfer.",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "hypothesis": {
        "value": "Web-scale contrastive training on image-text pairs produces visual models that transfer zero-shot to downstream computer vision benchmarks.",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "methodology": {
        "value": "Given a batch of N (image, text) pairs, CLIP is trained to predict which of the N × N possible (image, text) pairings across a batch actually occurred.",
        "start_char_doc": 18136,
        "end_char_doc": 18296,
        "prefix": "of zero-shot transfer to ImageNet.",
        "suffix": "To do this, CLIP learns",
        "valueSource": "extracted"
      },
