    {
      "@id": "exp:gread_real_world_node_classification",
      "@type": "mls:Experiment",
      "mention": {
        "start_char_doc": 24950,
        "end_char_doc": 24997,
        "prefix": "is available at https://github.com/jeongwhanchoi/GREAD. **",
        "suffix": "** **Real-world Datasets** We now",
        "valueSource": "extracted"
      },
      "schema:description": {
        "value": "We now evaluate the performance of GREAD and existing GNNs on a variety of real-world datasets. We consider 6 heterophilic datasets with low homophily ratios used in (Pei et al., 2020): i,ii) Chameleon, Squirrel (Rozemberczki et al., 2021), iii) Film (Tang et al., 2009), iv, v, vi) Texas, Wisconsin and Cornell from WebKB. We also test on 3 homophilic graphs with high homophily ratios: i) Cora (McCallum et al., 2000), ii) CiteSeer (Sen et al., 2008), iii) PubMed (Yang et al., 2016). Table 3 summarizes the number/size of nodes, edges, classes, features, and the homophily ratio. We use the dataset splits taken from (Pei et al., 2020). We report the mean and standard deviation accuracy after running each experiment with 10 fixed train/val/test splits.",
        "start_char_doc": 25024,
        "end_char_doc": 25781,
        "prefix": "on Real-world Datasets** **Real-world Datasets**",
        "suffix": "&lt;page_number&gt;5&lt;/page_number&gt; --- ## Page 6",
        "valueSource": "extracted"
      },
      "schema:objective": {
        "value": "Compare GREAD variants with strong GNN baselines on real-world node classification benchmarks.",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "schema:hypothesis": {
        "value": "Reaction-diffusion graph neural networks improve accuracy across heterophilic and homophilic datasets.",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "schema:methodology": {
        "value": "We report the mean and standard deviation accuracy after running each experiment with 10 fixed train/val/test splits.",
        "start_char_doc": 25664,
        "end_char_doc": 25781,
