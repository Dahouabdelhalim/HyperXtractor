        "prefix": "28 baselines, our method, called",
        "suffix": ", outperforms them in a",
        "valueSource": "extracted"
      },
      "schema:description": {
        "value": "To this end, we propose the concept of graph neural reaction-diffusion network (GREAD), which is one of the most generalized architectures since we consider both the diffusion and the reaction processes.",
        "start_char_doc": 6262,
        "end_char_doc": 6465,
        "prefix": "we consider 7 reaction processes.",
        "suffix": "Reaction-diffusion equations are physical models",
        "valueSource": "extracted"
      },
      "schema:version": null,
      "schema:architecture": {
        "value": "an encoder, a reaction-diffusion layer, and an output layer",
        "start_char_doc": 7048,
        "end_char_doc": 7107,
        "prefix": "GREAD, consists of three parts:",
        "suffix": "(cf. Eqs. (6) to (8)).",
        "valueSource": "extracted"
      },
      "schema:parameters": {
        "value": "trainable coefficients alpha and beta",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "mls:trainedOn": [
        {
          "@id": "dataset:texas"
        },
        {
          "@id": "dataset:wisconsin"
        },
        {
          "@id": "dataset:cornell"
        },
        {
          "@id": "dataset:film"
        },
        {
          "@id": "dataset:squirrel"
        },
        {
          "@id": "dataset:chameleon"
