    {
      "@id": "study:repository_of_conversational_datasets_2019",
      "@type": "Study",
      "mention": {
        "start_char_doc": 13,
        "end_char_doc": 52,
        "prefix": "## Page 1 #",
        "suffix": "github.com/PolyAI-LDN/conversational-datasets Matthew Henderson, Paweł Budzianowski,",
        "valueSource": "extracted"
      },
      "schema:title": {
        "value": "A Repository of Conversational Datasets",
        "start_char_doc": 13,
        "end_char_doc": 52,
        "prefix": "## Page 1 #",
        "suffix": "github.com/PolyAI-LDN/conversational-datasets Matthew Henderson, Paweł Budzianowski,",
        "valueSource": "extracted"
      },
      "schema:abstract": {
        "value": "Progress in Machine Learning is often driven by the availability of large datasets, and consistent evaluation metrics for comparing modeling approaches. To this end, we present a repository of conversational datasets consisting of hundreds of millions of examples, and a standardised evaluation procedure for conversational response selection models using 1-of-100 accuracy. The repository contains scripts that allow researchers to reproduce the standard datasets, or to adapt the pre-processing and data filtering steps to their needs. We introduce and evaluate several competitive baselines for conversational response selection, whose implementations are shared in the repository, as well as a neural encoder model that is trained on the entire training set.",
        "start_char_doc": 411,
        "end_char_doc": 1173,
        "prefix": "29 May 2019</watermark> ## Abstract",
        "suffix": ". ## 1 Introduction Dialogue",
        "valueSource": "extracted"
      },
      "schema:url": {
        "value": "https://arxiv.org/abs/1904.06472v2",
        "start_char_doc": 341,
        "end_char_doc": 359,
