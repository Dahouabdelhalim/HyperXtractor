        "prefix": "and a learned scaling factor. ##",
        "suffix": "Evaluation All the methods discussed",
        "valueSource": "extracted"
      },
      "mls:hypothesis": {
        "value": "Large-scale conversational datasets with a standardised evaluation framework (1-of-100 accuracy) enable effective training and benchmarking of conversational response selection models, and a neural encoder model trained on the full data significantly outperforms baseline methods.",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "mls:methodology": {
        "value": "Evaluate keyword-based baselines (TF-IDF, BM25), vector-based baselines (USE, ELMO, BERT with SIM and MAP methods), and a neural encoder model (POLYAI-ENCODER) on three standard conversational datasets using 1-of-100 accuracy computed on 50,000 test examples (500 batches of 100).",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "mls:evaluationMeasure": {"@id": "eval:1_of_100_accuracy"},
