        "start_char_doc": 430,
        "end_char_doc": 467,
        "prefix": "Technology (KIT), Germany michael.faerber@kit.edu &lt;watermark&gt;",
        "suffix": "&lt;/watermark&gt; ## Abstract In this",
        "valueSource": "extracted"
      },
