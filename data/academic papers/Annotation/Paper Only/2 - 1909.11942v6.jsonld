    {
      "@id": "exp:albert_xxlarge_glue",
      "@type": "Experiment",
      "schema:identifier": "ALBERT-xxlarge GLUE Evaluation",
      "schema:description": "ALBERT-xxlarge ensemble evaluated on GLUE benchmark achieving state-of-the-art score of 89.4",
      "schema:objective": "Achieve state-of-the-art on the GLUE benchmark with parameter-efficient ALBERT model",
      "schema:hypothesis": "Parameter-reduction techniques combined with SOP loss produce models that achieve SOTA on GLUE while having fewer parameters than BERT-large",
      "schema:methodology": "Pretrain ALBERT-xxlarge with MLM and SOP losses on BookCorpus and English Wikipedia, fine-tune on GLUE tasks with task-specific hyperparameters, report median over five runs on dev set and submit to leaderboard for test set",
      "realizes": [
        {
          "@id": "task:natural_language_understanding"
        }
      ],
      "usesData": [
        {
          "@id": "dataset:glue"
        }
      ],
      "produces": [
        {
          "@id": "model:albert_xxlarge"
        }
      ],
      "usesParameters": [
        {
          "@id": "hp:batch_size_pretraining"
        },
        {
          "@id": "hp:learning_rate_pretraining"
        },
        {
          "@id": "hp:max_steps_pretraining"
        },
        {
          "@id": "hp:max_seq_length_pretraining"
        },
        {
          "@id": "hp:vocab_size"
        },
        {
          "@id": "hp:num_layers_xxlarge"
        },
        {
          "@id": "hp:hidden_size_xxlarge"
        },
        {
          "@id": "hp:embedding_dim"
        },
        {
          "@id": "hp:dropout_pretraining"
        }
      ],
      "executes": [
        {
          "@id": "impl:albert_implementation"
        }
      ],
      "start_char_doc": 45193,
      "end_char_doc": 45213,
      "wasDerivedFrom": "paper",
      "context": {
        "prefix": "for all three benchmarks, achieving",
        "suffix": ", a SQuAD 2.0 test"
      }
    },
