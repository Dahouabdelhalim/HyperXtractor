    {
      "@id": "alg_prefix_beam",
      "@type": "MLS_Algorithm",
      "mls:name": "Prefix beam search decoding",
      "start_char_doc": 12803,
      "end_char_doc": 12830,
      "wasDerivedFrom": "paper",
      "context": {
        "prefix": "We experimented with two different approaches for the NER from speech task: E2E and a classical two-step approach. For the E2E approach, experiments were carried out on the model explained in Section 4.2. At the test time,",
        "suffix": "with a beam-width of 1024 and a 4-gram LM (trained on DATA2) is used."
      }
