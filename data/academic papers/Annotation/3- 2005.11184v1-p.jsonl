      "end_char_doc": 11609,
      "wasDerivedFrom": "paper",
      "mls:description": "Controls the contribution of LM during decoding",
      "context": {
        "prefix": "Where wc(y) is the word count in the predicted transcript. α and β control the contribution of LM and the number of words in the predicted transcript. In this study, we use values",
        "suffix": " & 6.0 for α and β, respectively."
