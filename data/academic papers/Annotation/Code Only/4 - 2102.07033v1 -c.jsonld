    {
      "@id": "impl_paq",
      "@type": "MLS_Implementation",
      "identifier": "PAQ QA-Pair Generation and RePAQ Retrieval Implementation",
      "codeRepository": "https://github.com/facebookresearch/PAQ",
      "framework": "PyTorch",
      "entryPoint": "paq/generation/generate_qa_pairs.py",
      "entryPointCommand": "python -m paq.generation.generate_qa_pairs --path_to_config generator_configs/paq_L1_config.json --passage_files_to_generate <passages> --output_dirs <output> --n_jobs -1 --verbose",
      "executionCommand": "python -m paq.retrievers.retrieve --model_name_or_path ./data/models/retrievers/retriever_multi_base_256 --qas_to_answer <test_file> --qas_to_retrieve_from <kb_file> --top_k 50 --output_file <output> --faiss_index_path <index> --fp16 --memory_friendly_parsing --verbose",
      "commitHash": null,
      "branch": "main",
      "dependenciesHash": null,
      "runsIn": {
        "@id": "env_paq"
      },
