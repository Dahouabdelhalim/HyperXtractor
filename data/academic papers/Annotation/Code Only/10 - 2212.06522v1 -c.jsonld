      "entryPoint": "main.py",
      "entryPointCommand": "python3 -u main.py --data_dir $DATA_ROOT --student1_model_name_or_path roberta-base --student2_model_name_or_path distilroberta-base --output_dir $OUTPUT --do_train --dataset conll03",
