      "start_char_doc": 0,
      "end_char_doc": 0,
      "context": { "prefix": "", "suffix": "" }
    },
    {
      "@id": "training_flair_ner",
      "@type": "TrainingRun",
      "runId": "flair_ner_training",
      "description": "Training of a Flair SequenceTagger for NER using GloVe word embeddings and Flair contextual embeddings (news-forward, news-backward) with CRF layer. Trains on CoNLL-format data with two columns (text, ner). Used as the 2-Step NER baseline approach.",
      "logFile": null,
      "artifactsLocation": null,
      "startedAtTime": null,
