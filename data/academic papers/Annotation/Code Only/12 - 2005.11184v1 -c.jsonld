    {
      "@id": "training_e2e_ner",
      "@type": "TrainingRun",
      "runId": "e2e_ner_training",
      "description": "Training of the E2E NER DeepSpeech2 model using CTC loss with SGD optimizer (Nesterov momentum), NVIDIA Apex mixed-precision (O0/O1), and learning rate annealing. Trains on speech audio with NER-annotated transcripts containing special character entity markers. Supports distributed training via multiproc.py.",
      "logFile": null,
      "artifactsLocation": "models/",
      "startedAtTime": null,
      "endedAtTime": null,
      "prov-executedBy": { "@id": "impl_e2e_ner" },
