  "@graph": [
    {
      "@id": "repo_openai_clip",
      "@type": "SoftwareRepository",
      "name": "CLIP",
      "description": "CLIP (Contrastive Language-Image Pre-Training) is a neural network trained on a variety of (image, text) pairs. It can be instructed in natural language to predict the most relevant text snippet, given an image, without directly optimizing for the task, similarly to the zero-shot capabilities of GPT-2 and 3.",
      "url": "https://github.com/OpenAI/CLIP",
      "owner": "OpenAI",
      "platform": "GitHub",
      "programmingLanguage": "Python",
      "version": "1.0",
      "license": "MIT",
      "dateModified": null,
      "documentationUrl": "https://github.com/OpenAI/CLIP/blob/main/README.md",
      "contains": [
        { "@id": "impl_clip" }
      ],
      "supports": [
        { "@id": "env_clip" }
      ],
      "wasDerivedFrom": "code",
      "codeReference": "README.md",
      "path": "README.md",
      "start_char_doc": 2,
      "end_char_doc": 6,
      "context": {
        "prefix": "#",
        "suffix": "[[Blog]](https://openai.com/blog/clip/) [[Paper]](https://arxiv.org/abs/2103.00020)"
      }
    },
    {
      "@id": "impl_clip",
      "@type": "MLS_Implementation",
      "identifier": "CLIP Implementation",
      "description": "Official PyTorch implementation of CLIP providing model loading, image preprocessing, text tokenization, and zero-shot inference via a Python package API.",
      "codeRepository": "https://github.com/OpenAI/CLIP",
      "framework": "PyTorch",
      "entryPoint": "clip/clip.py",
      "entryPointCommand": "pip install git+https://github.com/openai/CLIP.git",
      "executionCommand": "import clip; model, preprocess = clip.load('ViT-B/32')",
      "commitHash": "d05afc4",
      "branch": "main",
      "dependenciesHash": null,
      "runsIn": { "@id": "env_clip" },
      "requires": [
        { "@id": "dep_ftfy" },
        { "@id": "dep_packaging" },
        { "@id": "dep_regex" },
        { "@id": "dep_tqdm" },
        { "@id": "dep_torch" },
        { "@id": "dep_torchvision" }
      ],
      "wasDerivedFrom": "code",
      "codeReference": "clip/clip.py",
      "path": "clip/clip.py",
