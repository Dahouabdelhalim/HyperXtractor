    },
    {
      "id": "radar:evalrun/nyt",
      "type": "EvaluationRun",
      "runId": "radar-nyt-eval",
      "split": "test",
      "prov-executedBy": "radar:impl/main",
      "evaluates": "radar:model/radar-roberta-base",
