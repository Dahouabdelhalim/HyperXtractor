        "radar:hparam/encoder-lr",
        "radar:hparam/decoder-lr",
        "radar:hparam/focal-gamma",
        "radar:hparam/label-smoothing",
        "radar:hparam/batch-size"
      ]
    },
    {
      "id": "radar:trainrun/rcv1",
      "type": "TrainingRun",
