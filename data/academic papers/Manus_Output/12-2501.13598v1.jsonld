    {
      "@id": "experiment:htc_benchmarks",
      "@type": "Experiment",
      "salient": true,
      "schema:identifier": "HTC Benchmark Evaluation",
      "schema:description": "Evaluation of RADAr on three HTC benchmark datasets (WOS, NYT, RCV1-V2) comparing against state-of-the-art methods including HBGL, HGCLR, HiAGM, HTCInfoMax, HiMatch, SGM, Seq2Tree, and encoder-only/encoder-decoder baselines.",
      "schema:objective": "Demonstrate that RADAr achieves competitive results without graph encoder or label semantics",
      "schema:hypothesis": "An autoregressive decoder with child-to-parent label ordering can achieve competitive HTC performance without explicit label hierarchy encoding or label semantics",
      "schema:methodology": "Fine-tune RoBERTa encoder with custom autoregressive decoder on three benchmark datasets, compare Micro-F1 and Macro-F1 against baselines and state-of-the-art",
