    {
      "@id": "experiment_wos",
      "@type": "Experiment",
      "schema:identifier": "RADAr on WOS",
      "schema:description": "Evaluation of the RADAr model on the Web-of-Science (WOS) dataset with a two-level label hierarchy. The model took 29 training epochs.",
      "schema:objective": "Demonstrate that RADAr achieves competitive hierarchical text classification results without a graph encoder or label semantics",
      "schema:hypothesis": "An autoregressive decoder with child-to-parent label ordering can capture hierarchical information without explicit graph encoding",
      "schema:methodology": "Encoder-decoder architecture with RoBERTa encoder and custom autoregressive decoder, trained with focal loss and AdamW optimizer, hyperparameters selected via wandb sweep on validation set",
      "realizes": [{ "@id": "task_htc" }],
      "usesData": [{ "@id": "dataset_wos" }],
