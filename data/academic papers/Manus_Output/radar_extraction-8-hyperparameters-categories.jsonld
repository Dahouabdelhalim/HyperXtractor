    {
      "@id": "method_radar",
      "@type": ["MLS_Model", "Method"],
      "schema:name": "RADAr",
      "schema:description": "Transformer-based Autoregressive Decoder Architecture for Hierarchical Text Classification. Uses an off-the-shelf RoBERTa transformer as encoder and a custom autoregressive decoder with two decoder layers. Does not use a graph encoder for the label hierarchy nor label semantics. The decoder learns the sequence of labels organized from children to parents. Uses greedy search for decoding and focal loss for training.",
      "schema:version": null,
      "schema:architecture": "Encoder-Decoder (RoBERTa base encoder + 2-layer autoregressive transformer decoder with 8 attention heads, feedforward network, dropout 0.2)",
      "schema:parameters": "137M",
      "trainedOn": [
        { "@id": "dataset_wos" },
        { "@id": "dataset_nyt" },
        { "@id": "dataset_rcv1_v2" }
