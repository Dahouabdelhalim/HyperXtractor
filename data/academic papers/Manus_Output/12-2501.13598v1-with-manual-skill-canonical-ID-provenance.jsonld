      "schema:name": {
        "value": "Autoregressive Decoder",
        "start_char_doc": 1013,
        "end_char_doc": 1035,
        "prefix": "the input and a custom",
        "suffix": "with two decoder layers for",
        "valueSource": "extracted"
      },
      "schema:description": {
        "value": "Custom autoregressive transformer-based decoder trained from scratch. Consists of embedding and position embedding layers, two decoder layers (each with multi-head self-attention with 8 heads, layer normalization, dropout 0.2, cross-attention with encoder output, and a feedforward network), and a linear layer for logits. Uses greedy search for token generation and teacher forcing during training.",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
