    {
      "@id": "expg:group_hierarchical_text_classification_2025",
      "@type": "mls:ExperimentGroup",
      "mention": { "start_char_doc": 31702, "end_char_doc": 31999, "prefix": "<td>RADAr</td> <td><strong>", "suffix": "</strong></td> <td>our experiment</td> </tr>", "valueSource": "extracted" },
      "schema:identifier": { "value": "RADAr Hierarchical Text Classification Experiments", "start_char_doc": null, "end_char_doc": null, "prefix": null, "suffix": null, "valueSource": "inferred" },
      "schema:description": { "value": "Evaluation of the RADAr model on three benchmark HTC datasets (WOS, NYT, RCV1-V2). Results are averaged over five runs with different random seeds.", "start_char_doc": null, "end_char_doc": null, "prefix": null, "suffix": null, "valueSource": "inferred" },
      "schema:objective": { "value": "Demonstrate that RADAr achieves results competitive to the state of the art on HTC benchmarks without using a graph encoder for the label hierarchy or label semantics.", "start_char_doc": null, "end_char_doc": null, "prefix": null, "suffix": null, "valueSource": "inferred" },
      "schema:hypothesis": { "value": "An encoder-decoder model using an off-the-shelf RoBERTa encoder and a simple autoregressive decoder, without explicit graph encoding of the label hierarchy or label semantics, can achieve competitive HTC performance with less training and inference time compared to state-of-the-art models that rely on these features.", "start_char_doc": null, "end_char_doc": null, "prefix": null, "suffix": null, "valueSource": "inferred" },
      "schema:methodology": { "value": "Train RADAr (RoBERTa-base encoder + 2-layer autoregressive decoder) on each dataset with AdamW optimizer, separate learning rates for encoder (5e-5) and decoder (3e-4), ReduceLROnPlateau scheduler with patience 3, batch-level focal loss with gamma=2, label smoothing 0.1, gradient accumulation over 2 batches of 32 examples, teacher forcing, and greedy search decoding. Labels organized from children to parents with symbolic labels and <unk> level separators. Report mean and standard deviation of Micro-F1 and Macro-F1 over five runs.", "start_char_doc": null, "end_char_doc": null, "prefix": null, "suffix": null, "valueSource": "inferred" },
      "realizes": [{ "@id": "task:hierarchical_text_classification" }],
      "usesData": [
        { "@id": "dataset:wos" },
        { "@id": "dataset:nyt" },
        { "@id": "dataset:rcv1_v2" }
      ],
      "produces": [{ "@id": "model:radar" }],
      "usesParameters": [
        { "@id": "hp:learning_rate_encoder" },
        { "@id": "hp:learning_rate_decoder" },
        { "@id": "hp:learning_rate_lower_bound" },
        { "@id": "hp:scheduler_patience" },
        { "@id": "hp:decay_factor" },
        { "@id": "hp:training_patience" },
        { "@id": "hp:gamma_focal_loss" },
        { "@id": "hp:label_smoothing" },
        { "@id": "hp:batch_size" },
        { "@id": "hp:gradient_accumulation_steps" },
        { "@id": "hp:random_seed" },
        { "@id": "hp:num_decoder_layers" },
        { "@id": "hp:attention_heads_decoder" },
        { "@id": "hp:dropout_decoder" },
        { "@id": "hp:hidden_size_encoder" },
        { "@id": "hp:max_sequence_length" }
      ],
      "executes": [{ "@id": "impl:radar_pytorch" }],
      "mls:hasSubExperiment": [
        {
          "@id": "exp:radar_wos",
          "@type": "Experiment",
          "schema:identifier": { "value": "RADAr on WOS", "start_char_doc": null, "end_char_doc": null, "prefix": null, "suffix": null, "valueSource": "inferred" },
          "mention": { "start_char_doc": 31702, "end_char_doc": 31779, "prefix": "<td>RADAr</td> <td><strong>", "suffix": "</strong></td> <td><strong>79.84<sub>(0.07)</sub></strong></td>", "valueSource": "extracted" },
          "usesData": [{ "@id": "dataset:wos" }],
          "usesParameters": [{ "@id": "hp:num_epochs_wos" }],
          "mls:result": { "value": "Micro-F1=87.17 (std 0.04), Macro-F1=81.84 (std 0.08)", "start_char_doc": 31702, "end_char_doc": 31779, "prefix": "<td>RADAr</td> <td><strong>", "suffix": "</strong></td> <td><strong>79.84<sub>(0.07)</sub></strong></td>", "valueSource": "extracted" },
          "mls:evaluationMeasure": [
            { "@id": "eval:micro_f1_radar_wos" },
