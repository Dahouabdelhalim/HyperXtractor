      "schema:name": {
        "value": "Focal Loss (batch-level)",
        "start_char_doc": 16120,
        "end_char_doc": 16142,
        "prefix": "this imbalance, we employ a",
        "suffix": "[21], i.e., the model aims",
        "valueSource": "extracted"
      },
      "schema:description": {
        "value": "A modified version of cross-entropy loss that pays more attention to difficult samples with high loss. Applied at the batch level: computes model confidence e^(-loss), then perplexity 1-e^(-loss), raises to the power of focusing parameter gamma to get the modulating factor, and adjusts the batch cross-entropy loss. Uses label smoothing of 0.1.",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
