      "schema:name": {
        "value": "RADAr",
        "start_char_doc": 13,
        "end_char_doc": 18,
        "prefix": "## Page 1 #",
        "suffix": ": A Transformer-based Autoregressive Decoder",
        "valueSource": "extracted"
      },
      "schema:description": {
        "value": "Transformer-based Autoregressive Decoder Architecture for hierarchical text classification. Uses an off-the-shelf RoBERTa-base encoder and a custom autoregressive decoder with two decoder layers. Does not use a graph encoder for the label hierarchy nor label semantics. Labels are organized from children to parents and encoded as symbolic labels.",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "schema:version": { "value": null, "start_char_doc": null, "end_char_doc": null, "prefix": null, "suffix": null, "valueSource": "inferred" },
      "schema:architecture": {
        "value": "RoBERTa-base encoder + custom autoregressive decoder (2 layers, 8 heads)",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "schema:parameters": {
        "value": "137M",
        "start_char_doc": 26508,
        "end_char_doc": 26512,
        "prefix": "more parameters than HBGL (",
        "suffix": "vs. 110M), it requires less",
        "valueSource": "extracted"
      },
      "trainedOn": [
