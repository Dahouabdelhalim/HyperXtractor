    {
      "@id": "method:autoregressive_decoder",
      "@type": "Method",
      "mention": {
        "start_char_doc": 1013,
        "end_char_doc": 1059,
        "prefix": "the input and a custom",
        "suffix": "for generating the classification output.",
        "valueSource": "extracted"
