    {
      "@id": "study_radar",
      "@type": "Study",
      "title": "RADAr: A Transformer-based Autoregressive Decoder Architecture for Hierarchical Text Classification",
      "abstract": "Recent approaches in hierarchical text classification (HTC) rely on the capabilities of a pre-trained transformer model and exploit the label semantics and a graph encoder for the label hierarchy. In this paper, we introduce an effective hierarchical text classifier RADAr...",
      "url": "https://arxiv.org/abs/2501.13598v1",
      "hasAuthor": [
        { "@id": "person_yousef" },
        { "@id": "person_lukas" },
        { "@id": "person_ansgar" }
      ],
      "contains": [
        { "@id": "experiment_main" }
      ],
      "implements": { "@id": "repo_radar" },
