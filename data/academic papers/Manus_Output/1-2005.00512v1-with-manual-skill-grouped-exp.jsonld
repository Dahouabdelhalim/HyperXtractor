    {
      "@id": "exp:group_scirex",
      "@type": "mls:ExperimentGroup",
      "schema:identifier": "SCIREX Document-Level IE Experiments",
      "schema:description": "End-to-end evaluation of the SCIREX baseline model on the SCIREX dataset across three subtasks: mention identification, end-to-end binary relation extraction, and 4-ary relation extraction.",
      "schema:objective": "Establish baseline performance on the SCIREX dataset and identify bottlenecks in document-level IE.",
      "schema:hypothesis": "A document-level neural model that jointly performs mention identification, saliency classification, coreference resolution, and relation extraction will outperform paragraph-level approaches on cross-section relations, though identifying salient entities remains the key bottleneck.",
      "schema:methodology": "Joint training of mention identification (CRF), saliency classification (FFN), and relation extraction (section-level FFN) with SciBERT+BiLSTM document representation. Separate SciBERT model for pairwise coreference. Three losses weighted equally: negative log-likelihood (mention ID), binary cross-entropy (saliency), binary cross-entropy (relations). Evaluated on SCIREX test set with macro F1 for mentions and positive class F1 for relations.",
      "realizes": [{ "@id": "task:doc_level_ie" }],
      "usesData": [{ "@id": "dataset:scirex" }],
      "produces": [{ "@id": "model:scirex_baseline" }],
      "usesParameters": [
        { "@id": "hp:lr_nonbert" },
        { "@id": "hp:lr_bert" },
        { "@id": "hp:num_epochs" },
        { "@id": "hp:patience" },
