        { "@id": "hp:hidden_size_bilstm" },
        { "@id": "hp:ffn_num_layers" },
        { "@id": "hp:ffn_hidden_size" },
        { "@id": "hp:activation" },
        { "@id": "hp:max_seq_length" },
        { "@id": "hp:train_val_test_split" }
      ],
      "executes": [{ "@id": "impl:scirex" }],
