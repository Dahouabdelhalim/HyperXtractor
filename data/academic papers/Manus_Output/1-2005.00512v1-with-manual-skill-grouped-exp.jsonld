    {
      "@id": "task:doc_level_ie",
      "@type": "MLS_Task",
      "schema:name": "Document-Level Information Extraction",
      "schema:description": "Extracting entities, their coreferences, salient entity identification, and N-ary relation extraction from full scientific documents. Encompasses entity recognition, salient entity identification, coreference resolution, and N-ary relation extraction.",
      "schema:category": "Information Extraction",
      "schema:metrics": "F1 score (macro average for mention identification; positive class F1 for binary classification tasks and relation extraction)",
      "benchmarkedOn": [{ "@id": "dataset:scirex" }],
      "subTaskOf": [],
      "start_char_doc": 798,
      "end_char_doc": 823,
      "wasDerivedFrom": "paper",
      "context": {
