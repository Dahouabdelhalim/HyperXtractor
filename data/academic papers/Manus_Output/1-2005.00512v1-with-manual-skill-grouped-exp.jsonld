        "suffix": "that encompasses multiple IE tasks,"
      }
    },

    {
      "@id": "dataset:scirex",
      "@type": "MLS_Dataset",
      "schema:name": "SCIREX",
      "schema:description": "A document-level information extraction dataset consisting of 438 fully annotated scientific articles from ML conferences. Annotated with entity mentions, coreferences, salient entities, and N-ary relations (Dataset, Metric, Task, Method tuples). Average per document: 5,737 words, 22 sections, 360 mentions, 8 salient entities, 16 binary relations, 5 4-ary relations.",
      "schema:numInstances": 438,
      "schema:language": "English",
      "schema:license": null,
      "schema:modality": "Text",
      "schema:numClasses": 4,
      "subDatasetOf": [],
      "prov-derivedFrom": [{ "@id": "source:pwc" }],
      "processedThrough": [],
      "start_char_doc": 788,
      "end_char_doc": 823,
      "wasDerivedFrom": "paper",
      "context": {
        "prefix": "In this paper, we introduce",
        "suffix": "that encompasses multiple IE tasks,"
      }
    },
