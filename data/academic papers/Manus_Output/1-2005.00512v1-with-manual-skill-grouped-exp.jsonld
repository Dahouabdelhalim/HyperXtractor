    {
      "@id": "model:scirex_baseline",
      "@type": ["MLS_Model", "Method"],
      "schema:name": "SCIREX Baseline Model",
      "schema:description": "A neural end-to-end document-level information extraction model. Uses SciBERT-base + BiLSTM for document representation, a CRF tagger for mention identification and classification, feedforward layers for salient mention classification, a separate SciBERT-based pairwise coreference model, agglomerative hierarchical clustering for entity clustering, and section-level relation extraction with FFN classification.",
      "schema:version": null,
      "schema:architecture": "SciBERT-base + BiLSTM + CRF + FFN + Agglomerative Clustering",
      "schema:parameters": null,
      "trainedOn": [{ "@id": "dataset:scirex" }],
      "evaluatedOn": [
        { "@id": "dataset:scirex" },
        { "@id": "dataset:scierc" }
      ],
      "achieves": [
        { "@id": "eval:mention_id_f1" },
        { "@id": "eval:binary_rel_f1" },
        { "@id": "eval:4ary_rel_f1" }
      ],
      "prov-producedBy": null,
      "subMethod": [
        { "@id": "model:scibert_encoder" },
        { "@id": "method:bilstm" },
        { "@id": "method:crf_tagger" },
        { "@id": "model:coref_model" }
      ],
      "start_char_doc": 1101,
      "end_char_doc": 1147,
      "wasDerivedFrom": "paper",
      "context": {
        "prefix": "leveraging existing scientific knowledge resources.",
        "suffix": "that extends previous state-of-the-art IE"
      }
    },
