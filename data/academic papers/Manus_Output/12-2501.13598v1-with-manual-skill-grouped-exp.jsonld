    {
      "@id": "method:autoregressive_decoder",
      "@type": ["MLS_Model", "Method"],
      "schema:name": "RADAr Autoregressive Decoder",
      "schema:description": "A custom autoregressive transformer-based decoder trained from scratch. Consists of embedding and position embedding layers, followed by two decoder layers and a linear layer. Each decoder layer has a transformer block with eight attention heads, a feedforward network, and uses dropout of 0.2. The decoder vocabulary corresponds to the symbolic label set. Uses greedy search for token generation.",
      "schema:version": null,
      "schema:architecture": "Autoregressive transformer decoder with 2 layers",
      "schema:parameters": null,
      "trainedOn": [],
      "evaluatedOn": [],
      "achieves": [],
      "prov-producedBy": null,
      "subMethod": [],
      "start_char_doc": 1013,
      "end_char_doc": 1059,
      "wasDerivedFrom": "paper",
      "context": {
        "prefix": "the input and a custom",
        "suffix": "for generating the classification output."
      }
    },

    {
      "@id": "method:focal_loss",
      "@type": ["MLS_Algorithm", "Method"],
      "schema:name": "Focal Loss (batch-level)",
