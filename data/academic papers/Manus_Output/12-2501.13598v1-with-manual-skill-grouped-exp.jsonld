    {
      "@id": "exp:group_radar_htc",
      "@type": "mls:ExperimentGroup",
      "schema:identifier": "RADAr HTC Experiments",
      "schema:description": "Evaluation of the RADAr model on three hierarchical text classification benchmark datasets (WOS, NYT, RCV1-V2). Results are reported as the mean and standard deviation over five runs with different random seeds.",
      "schema:objective": "Demonstrate that RADAr achieves results competitive to the state of the art without using a graph encoder for the label hierarchy or label semantics.",
      "schema:hypothesis": "An effective hierarchical text classifier can be built using only an off-the-shelf pre-trained transformer encoder and a simple autoregressive decoder, without explicit encoding of the label hierarchy or label semantics, while achieving competitive performance with less training and inference time.",
      "schema:methodology": "Use RoBERTa base as encoder and a custom autoregressive decoder with two decoder layers. Train with AdamW optimizer, focal loss (gamma=2), label smoothing of 0.1, and gradient accumulation. Labels are organized from children to parents using symbolic labels with level separators. Report mean and standard deviation over five runs with different random seeds.",
      "realizes": [{ "@id": "task:htc" }],
      "produces": [{ "@id": "method:radar" }],
      "usesParameters": [
        { "@id": "hp:lr_encoder" },
        { "@id": "hp:lr_decoder" },
        { "@id": "hp:lr_encoder_lower_bound" },
        { "@id": "hp:scheduler_patience" },
