    {
      "@id": "method:radar",
      "@type": ["MLS_Model", "Method"],
      "schema:name": "RADAr (Transformer-based Autoregressive Decoder Architecture)",
      "schema:description": "A transformer-based encoder-decoder model for hierarchical text classification. Uses an off-the-shelf RoBERTa base as encoder and a custom autoregressive decoder with two decoder layers. Does not use a graph encoder for the label hierarchy nor label semantics. Employs focal loss (scaled cross-entropy) to pay more attention to difficult samples. Labels are organized from children to parents.",
      "schema:version": null,
      "schema:architecture": "Encoder-Decoder (RoBERTa encoder + custom autoregressive transformer decoder)",
      "schema:parameters": "137M",
      "trainedOn": [
        { "@id": "dataset:wos" },
        { "@id": "dataset:nyt" },
        { "@id": "dataset:rcv1v2" }
      ],
      "evaluatedOn": [
        { "@id": "dataset:wos" },
        { "@id": "dataset:nyt" },
        { "@id": "dataset:rcv1v2" }
      ],
      "achieves": [
        { "@id": "eval:radar_wos_micro_f1" },
        { "@id": "eval:radar_wos_macro_f1" },
        { "@id": "eval:radar_nyt_micro_f1" },
        { "@id": "eval:radar_nyt_macro_f1" },
        { "@id": "eval:radar_rcv1v2_micro_f1" },
        { "@id": "eval:radar_rcv1v2_macro_f1" }
      ],
      "prov-producedBy": null,
      "subMethod": [
        { "@id": "method:roberta_encoder" },
        { "@id": "method:autoregressive_decoder" }
      ],
      "start_char_doc": 858,
      "end_char_doc": 919,
      "wasDerivedFrom": "paper",
      "context": {
        "prefix": "an effective hierarchical text classifier",
        "suffix": "that is based only on"
      }
    },
