        { "@id": "hp:random_seed" },
        { "@id": "hp:decoder_num_layers" },
        { "@id": "hp:decoder_attention_heads" },
        { "@id": "hp:decoder_dropout" },
        { "@id": "hp:max_seq_length" },
        { "@id": "hp:hidden_size" },
        { "@id": "hp:decay_rate" }
      ],
      "executes": [{ "@id": "impl:radar" }],
      "start_char_doc": 31702,
