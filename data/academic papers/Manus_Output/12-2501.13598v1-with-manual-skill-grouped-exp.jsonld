      "schema:description": "Pre-trained RoBERTa base model used as the encoder component of RADAr. Produces a fixed-size context tensor of size (512, 768) that captures the linguistic information found in the input text.",
      "schema:version": "base",
      "schema:architecture": "Transformer encoder-only",
      "schema:parameters": null,
